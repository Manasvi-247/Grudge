# All optional. With none of these set, Grudge runs in demo mode:
# simulator buttons work, issues are logged instead of posted.

# Port for the server (default 4321)
#PORT=4321

# --- real mode, easiest version: poll your GitHub activity (no tunnel needed) ---
# Your commits feed the pet within ~90s. Public events only without a token.
#GITHUB_USERNAME=your-github-username
#GITHUB_TOKEN=ghp_xxx   # PAT; also needed for opening issues

# Repo where the pet opens its passive-aggressive issues (needs GITHUB_TOKEN with issues:write)
#GITHUB_ISSUE_REPO=your-username/grudge

# --- real mode, webhook version (deploy or tunnel required) ---
# Set the same secret in your GitHub webhook config; events: push, workflow_run
#WEBHOOK_SECRET=something-long-and-random
